# EXAMIS staging. provision.sh fills the __PLACEHOLDERS__ and writes
# /srv/examis/shared/.env once. Synthetic data only: never point this at "sis".
APP_NAME=EXAMIS
APP_ENV=staging
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=https://__STUDENTS_HOST__
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=examis_staging
DB_USERNAME=examis_app
DB_PASSWORD=__DB_APP_PASSWORD__
DB_PERSISTENT=true

# Sessions stay on the database: deactivating staff deletes their rows.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=failover
CACHE_FAILOVER_STORES=redis,database
QUEUE_CONNECTION=failover
QUEUE_FAILOVER_CONNECTIONS=redis,database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=__REDIS_PASSWORD__
REDIS_PORT=6379

MAIL_MAILER=log

EXAMIS_STUDENTS_HOST=__STUDENTS_HOST__
EXAMIS_STAFF_HOST=__STAFF_HOST__
# Cloudflare Access sync of staff e-mails (App\Services\Staff\CloudflareAccess).
CLOUDFLARE_ACCESS_ACCOUNT_ID=
CLOUDFLARE_ACCESS_TOKEN=
CLOUDFLARE_ACCESS_ALWAYS_ALLOW=
EXAMIS_CSP_ENABLED=true
EXAMIS_HSTS_ENABLED=false
EXAMIS_LOGIN_ATTEMPTS_PER_IP_PER_HOUR=100

DOCUMENTS_DISK=documents
DOCUMENT_SCANNER=clamav
CLAMAV_SOCKET=unix:///run/clamav/clamd.ctl
DOCUMENT_SCAN_INLINE=true
EXAMIS_FORM_CACHE=true
DOCUMENTS_QUEUE=documents
# times.ttf and timesbd.ttf (Arabic-capable, from Windows); DejaVu Sans if missing.
EXAMIS_RECEIPT_FONT_DIR=/srv/examis/shared/fonts
